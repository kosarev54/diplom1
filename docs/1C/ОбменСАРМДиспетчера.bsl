// ═══════════════════════════════════════════════════════════════════════════
//  Обмен 1С:Предприятие 8.3  ↔  АРМ диспетчера (HTTP, JSON)
//
//  Как подключить:
//   1. Создайте общий модуль «ОбменСАРМДиспетчера» (флажки «Сервер», «Вызов сервера»)
//      и вставьте в него этот текст.
//   2. В обработке проведения документа «Заказ клиента» (или «Реализация») вызовите
//          ОбменСАРМДиспетчера.ОтправитьЗаказВДоставку(Ссылка);
//      — заказ сразу появится у диспетчера в списке «Заказы» (источник «1С»).
//   3. Создайте регламентное задание (раз в 5 минут) с методом
//          ОбменСАРМДиспетчера.ЗагрузитьСтатусыДоставки();
//      — 1С получает статусы, водителя, ТС и координаты машины для заказов в пути.
//   4. «Где заказ» по кнопке в документе:  ОбменСАРМДиспетчера.ГдеЗаказ(Строка(Ссылка.УникальныйИдентификатор()))
//
//  Имена реквизитов документа (Контрагент, АдресДоставки, Товары…) замените на свои.
//  Адрес, порт и ключ API подставлены программой АРМ диспетчера при сохранении модуля
//  (страница «Интеграция 1С» → «Сохранить модуль для 1С»).
// ═══════════════════════════════════════════════════════════════════════════

Функция Настройки()
	Н = Новый Структура;
	Н.Вставить("Сервер",  "{{HOST}}");   // компьютер диспетчера
	Н.Вставить("Порт",    {{PORT}});
	Н.Вставить("КлючAPI", "{{KEY}}");     // АРМ → «Интеграция 1С» → «Ключ API»
	Возврат Н;
КонецФункции

Функция НовоеСоединение()
	Н = Настройки();
	Возврат Новый HTTPСоединение(Н.Сервер, Н.Порт, , , , 30);
КонецФункции

Функция ПрочитатьОтвет(Ответ)
	Текст = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат Новый Структура("ok, error", Ложь, "Пустой ответ, код " + Ответ.КодСостояния);
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Результат = ПрочитатьJSON(Чтение, Ложь);
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции

Процедура ПроверитьОтвет(Ответ, Результат)
	Если Ответ.КодСостояния = 200 Тогда
		Возврат;
	КонецЕсли;
	Текст = "";
	Если Результат.Свойство("error") Тогда
		Текст = Результат.error;
	ИначеЕсли Результат.Свойство("message") Тогда
		Текст = Результат.message;
	КонецЕсли;
	ВызватьИсключение "АРМ диспетчера (" + Ответ.КодСостояния + "): " + Текст;
КонецПроцедуры

// ─── Отправка заказов ──────────────────────────────────────────────────────

// МассивЗаказов — массив структур с полями:
//   ExternalId (обязательно, уникальный код заказа в 1С), ClientName, ClientPhone, Address,
//   Latitude, Longitude (0 — если координат нет), Weight (кг), Volume (м3), DeliveryPrice,
//   Priority (Low/Normal/High/Urgent), DeliveryDate (ГГГГ-ММ-ДД), Notes,
//   Goods — массив структур Name, Qty, Unit, UnitPrice, ArticleNumber.
// Повторная отправка того же ExternalId не создаёт дубль.
Функция ОтправитьЗаказы(МассивЗаказов) Экспорт
	Данные = Новый Структура("Source, Version, Orders", "1C:Enterprise", "8.3", МассивЗаказов);
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Данные);
	Тело = ЗаписьJSON.Закрыть();

	Запрос = Новый HTTPЗапрос("/api/1c/orders");
	Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Запрос.Заголовки.Вставить("X-Api-Key", Настройки().КлючAPI);
	Запрос.УстановитьТелоИзСтроки(Тело, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

	Ответ = НовоеСоединение().ОтправитьДляОбработки(Запрос);
	Результат = ПрочитатьОтвет(Ответ);
	ПроверитьОтвет(Ответ, Результат);
	Возврат Результат;   // imported, skippedDuplicates, errors, message
КонецФункции

Функция ОтправитьЗаказВДоставку(ДокументСсылка) Экспорт
	Заказ = Новый Структура;
	Заказ.Вставить("ExternalId",    Строка(ДокументСсылка.УникальныйИдентификатор()));
	Заказ.Вставить("ClientName",    Строка(ДокументСсылка.Контрагент));
	Заказ.Вставить("ClientPhone",   "");
	Заказ.Вставить("Address",       Строка(ДокументСсылка.АдресДоставки));
	Заказ.Вставить("Latitude",      0);
	Заказ.Вставить("Longitude",     0);
	Заказ.Вставить("Weight",        0);
	Заказ.Вставить("Volume",        0);
	Заказ.Вставить("DeliveryPrice", ДокументСсылка.СуммаДокумента);
	Заказ.Вставить("Priority",      "Normal");
	Заказ.Вставить("DeliveryDate",  Формат(ДокументСсылка.ДатаОтгрузки, "ДФ=yyyy-MM-dd"));
	Заказ.Вставить("Notes",         "Заказ 1С № " + ДокументСсылка.Номер);

	Товары = Новый Массив;
	Для Каждого СтрокаТЧ Из ДокументСсылка.Товары Цикл
		Товар = Новый Структура;
		Товар.Вставить("Name",          Строка(СтрокаТЧ.Номенклатура));
		Товар.Вставить("Qty",           СтрокаТЧ.Количество);
		Товар.Вставить("Unit",          "шт");
		Товар.Вставить("UnitPrice",     СтрокаТЧ.Цена);
		Товар.Вставить("ArticleNumber", "");
		Товары.Добавить(Товар);
	КонецЦикла;
	Заказ.Вставить("Goods", Товары);

	Массив = Новый Массив;
	Массив.Добавить(Заказ);
	Возврат ОтправитьЗаказы(Массив);
КонецФункции

// ─── Статусы и местоположение ──────────────────────────────────────────────

// Возвращает массив структур: externalId, internalId, orderNumber, status, statusText,
// driverName, driverPhone, vehicle, deliveredAt, amount, driverLat, driverLon, locationTime.
Функция ПолучитьСтатусы(ИзмененыПосле = Неопределено) Экспорт
	Адрес = "/api/1c/statuses";
	Если ЗначениеЗаполнено(ИзмененыПосле) Тогда
		Адрес = Адрес + "?since=" + Формат(ИзмененыПосле, "ДФ=yyyy-MM-ddTHH:mm:ss");
	КонецЕсли;
	Запрос = Новый HTTPЗапрос(Адрес);
	Запрос.Заголовки.Вставить("X-Api-Key", Настройки().КлючAPI);
	Ответ = НовоеСоединение().Получить(Запрос);
	Результат = ПрочитатьОтвет(Ответ);
	ПроверитьОтвет(Ответ, Результат);
	Возврат Результат.statuses;
КонецФункции

Процедура ЗагрузитьСтатусыДоставки() Экспорт
	Статусы = ПолучитьСтатусы(ТекущаяДатаСеанса() - 24 * 3600);
	Для Каждого Ст Из Статусы Цикл
		// Здесь — запись в свой регистр сведений «СтатусыДоставки»
		// (Заказ = по Ст.externalId, Статус = Ст.statusText, Водитель, ТС, ДатаДоставки).
		Текст = Ст.orderNumber + ": " + Ст.statusText;
		Если Ст.Свойство("driverName") Тогда
			Текст = Текст + " — " + Ст.driverName;
		КонецЕсли;
		Если Ст.Свойство("driverLat") Тогда
			Текст = Текст + " (машина: " + Формат(Ст.driverLat, "ЧРД=.; ЧГ=0") + ", " + Формат(Ст.driverLon, "ЧРД=.; ЧГ=0") + ")";
		КонецЕсли;
		Сообщить(Текст);
	КонецЦикла;
КонецПроцедуры

// «Где заказ»: stage (этап), details, driver.name/phone/vehicle/lat/lon/distanceKm/etaMinutes.
Функция ГдеЗаказ(ВнешнийИд) Экспорт
	Запрос = Новый HTTPЗапрос("/api/1c/track?externalId=" + КодироватьСтроку(ВнешнийИд, СпособКодированияСтроки.КодировкаURL));
	Запрос.Заголовки.Вставить("X-Api-Key", Настройки().КлючAPI);
	Ответ = НовоеСоединение().Получить(Запрос);
	Результат = ПрочитатьОтвет(Ответ);
	ПроверитьОтвет(Ответ, Результат);
	Возврат Результат;
КонецФункции
